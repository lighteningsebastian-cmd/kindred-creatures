# Kindred Creature Co. environment variables.
# Copy to .env.local and fill in real values. Never commit .env.local.

# Postgres connection string
# DATABASE_URL=

# OpenAI API key for the portrait pipeline
# OPENAI_API_KEY=

# Set to "true" to use mock implementations instead of real external services
# MOCK_SERVICES=

# PayFast merchant credentials
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=
# Set to "true" for the PayFast sandbox
# PAYFAST_SANDBOX=

# Resend API key for transactional email. Absent (or MOCK_SERVICES=true) means
# emails are logged to the console instead of sent.
# RESEND_API_KEY=

# Resend Audience id for the newsletter list. Optional: absent (or with no
# RESEND_API_KEY, or MOCK_SERVICES=true) means subscribe/unsubscribe are logged
# to the console instead of pushed to a mailing list.
# RESEND_AUDIENCE_ID=

# Signing secret for Resend's delivery webhooks ("whsec_...", from the Resend
# dashboard under Webhooks). Absent means the /api/webhooks/resend endpoint
# rejects everything and logs, so delivery monitoring is off but never open.
# RESEND_WEBHOOK_SECRET=

# From address on every outgoing email. The domain must be verified in Resend.
# Defaults to "Kindred Creatures <hello@kindredcreatures.co.za>".
# EMAIL_FROM=

# Where customer and print-shop replies land. Defaults to hello@kindredcreatures.co.za.
# EMAIL_REPLY_TO=

# Print shop notification recipient. Job sheets are not sent without it.
# PRINT_SHOP_EMAIL=

# Admin login (/admin). The dashboard is CLOSED unless BOTH of these are set:
# with no hash, no password can match and no session cookie can be signed.
# Generate the hash with:
#
#   node scripts/hash-admin-password.ts
#
# It prompts on stdin and prints a scrypt hash carrying its own salt and cost.
# Changing it signs out every live admin session, by design.
# ADMIN_EMAIL=
# ADMIN_PASSWORD_HASH=

# Google Analytics measurement id (exposed to the browser)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Public site URL, e.g. https://kindredcreature.co.za (exposed to the browser)
# NEXT_PUBLIC_SITE_URL=

# Google Business Profile reviews URL (exposed to the browser). Optional: while
# unset, the "Read our Google reviews" link renders nothing, so the footer is
# safe before the owner has a profile to point at.
# NEXT_PUBLIC_GOOGLE_REVIEWS_URL=

# Secret used to sign order lookup tokens
# ORDER_TOKEN_SECRET=
