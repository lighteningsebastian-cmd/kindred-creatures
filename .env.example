# Kindred Creature Co. environment variables.
# Copy to .env.local and fill in real values. Never commit .env.local.

# Postgres connection string
# DATABASE_URL=

# OpenAI API key for the portrait pipeline
# OPENAI_API_KEY=

# Set to "true" to use mock implementations instead of real external services
# MOCK_SERVICES=

# PayFast merchant credentials
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=
# Set to "true" for the PayFast sandbox
# PAYFAST_SANDBOX=

# Resend API key for transactional email
# RESEND_API_KEY=

# Print shop notification recipient
# PRINT_SHOP_EMAIL=

# Admin login
# ADMIN_EMAIL=
# ADMIN_PASSWORD_HASH=

# Google Analytics measurement id (exposed to the browser)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Public site URL, e.g. https://kindredcreature.co.za (exposed to the browser)
# NEXT_PUBLIC_SITE_URL=

# Secret used to sign order lookup tokens
# ORDER_TOKEN_SECRET=
